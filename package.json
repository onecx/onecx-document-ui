{
  "name": "onecx-document-ui",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "contributors": [
    "OneCX Development Team <onecx_dev@1000kit.org>"
  ],
  "config": {
    "openapiYaml": "src/assets/api/openapi-bff.yaml",
    "openapiOutput": "src/app/shared/generated",
    "jest.params": "--noStackTrace --codeCoverage"
  },
  "scripts": {
    "build": "nx build",
    "postbuild": "mv \"$(find dist/onecx-document-ui -maxdepth 1 -type f -name 'styles.*.css' | head -n 1)\" dist/onecx-document-ui/styles.css",
    "check": "nx lint --cache=true && npx prettier -c --cache .",
    "clean": "npm cache clean --force && rm -rf *.log dist reports .nx .angular .eslintcache ./node_modules/.cache/prettier/.prettier-cache",
    "lint": "nx lint --cache=true && npx prettier -c --cache .",
    "format": "nx lint --fix",
    "eslint": "eslint --quiet --ext .js,.ts src",
    "audit": "npm audit --audit-level=high",
    "browser": "npx browserslist",
    "prepare": "husky || true",
    "start": "nx serve --configuration=development --proxy-config=proxy.conf.js",
    "test": "nx test $npm_package_config_jest_params",
    "test:ci": "nx test $npm_package_config_jest_params --watch=false",
    "sonar": "npx sonar-scanner",
    "apigen-cleanup": "rm -rf $npm_package_config_openapiOutput",
    "apigen-format": "npx prettier $npm_package_config_openapiYaml --write && npx prettier $npm_package_config_openapiOutput/**/* --write",
    "apigen-generate": "openapi-generator-cli generate -i $npm_package_config_openapiYaml -g typescript-angular -c apigen.yaml -o $npm_package_config_openapiOutput --type-mappings=AnyType=object,set=Array",
    "apigen": "npm run apigen-cleanup && npm run apigen-generate && npm run apigen-format"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "text",
      "lcov",
      "text-summary"
    ],
    "preset": "jest-preset-angular",
    "reporters": [
      "default",
      [
        "jest-sonar",
        {
          "outputDirectory": "reports",
          "outputName": "sonarqube_report.xml",
          "reportedFilePath": "absolute"
        }
      ]
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ]
  },
  "jestSonar": {
    "reportPath": "reports"
  },
  "dependencies": {
    "@angular-architects/module-federation": "^19.0.3",
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.17",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/elements": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@ngrx/component": "^19.2.1",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngrx/store-devtools": "^19.2.1",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^8.0.0",
    "@nx/angular": "^20.5.0",
    "@nx/devkit": "^20.5.0",
    "@nx/plugin": "^20.5.0",
    "@onecx/accelerator": "^6.27.1",
    "@onecx/angular-accelerator": "^6.27.1",
    "@onecx/angular-auth": "^6.27.1",
    "@onecx/angular-integration-interface": "^6.27.1",
    "@onecx/angular-remote-components": "^6.27.1",
    "@onecx/angular-testing": "^6.27.1",
    "@onecx/angular-utils": "^6.27.1",
    "@onecx/angular-webcomponents": "^6.27.1",
    "@onecx/integration-interface": "^6.27.1",
    "@onecx/ngrx-accelerator": "^6.27.1",
    "@onecx/nx-plugin": "^6.0.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "ngrx-store-localstorage": "^19.0.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^19.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zod": "^3.22.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.25",
    "@angular-devkit/core": "^19.2.25",
    "@angular-devkit/schematics": "^19.2.25",
    "@angular-eslint/builder": "^19.2.22",
    "@angular-eslint/eslint-plugin": "^19.2.22",
    "@angular-eslint/eslint-plugin-template": "^19.2.22",
    "@angular-eslint/schematics": "^19.2.22",
    "@angular-eslint/template-parser": "^19.2.22",
    "@angular/cli": "^19.2.25",
    "@angular/compiler-cli": "^19.2.25",
    "@angular/language-service": "^19.2.25",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nx/angular": "20.5.0",
    "@nx/eslint": "20.5.0",
    "@nx/eslint-plugin": "20.5.0",
    "@nx/jest": "20.5.0",
    "@nx/js": "20.5.0",
    "@nx/workspace": "20.5.0",
    "@openapitools/openapi-generator-cli": "^2.5.2",
    "@schematics/angular": "^19.2.25",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "detect-secrets": "^1.0.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-marbles": "3.1.1",
    "jest-preset-angular": "~14.4.2",
    "jest-sonar": "^0.2.16",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^16.4.0",
    "ngx-translate-testing": "^7.0.0",
    "nx": "20.5.0",
    "prettier": "^3.5.3",
    "sonar-scanner": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
